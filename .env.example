# Copy to .env and fill in. Never commit the result.

# --- Database ---
DB_URL=jdbc:postgresql://localhost:5432/authservice
DB_USERNAME=auth
DB_PASSWORD=change-me

# --- Token identity ---
# Both are verified on incoming tokens, so every deployment needs its own pair.
AUTH_JWT_ISSUER=https://auth.example.com
AUTH_JWT_AUDIENCE=example-clients
AUTH_JWT_ACCESSTOKENTTL=15m

# --- Signing keys ---
# Generate with:
#   openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out private.pem
#   openssl rsa -pubout -in private.pem -out public.pem
#
# Note the variable names: Spring maps auth.jwt.private-key to AUTH_JWT_PRIVATEKEY.
# The hyphen is removed, not turned into an underscore, so AUTH_JWT_PRIVATE_KEY
# would be silently ignored and the service would refuse to start.
AUTH_JWT_PRIVATEKEY=file:/etc/auth/private.pem
AUTH_JWT_PUBLICKEY=file:/etc/auth/public.pem

# --- Sessions ---
AUTH_REFRESHTOKEN_TTL=30d
AUTH_REFRESHTOKEN_CLEANUPCRON=0 15 3 * * *

# --- Brute-force protection ---
AUTH_LOGIN_MAXFAILEDATTEMPTS=5
AUTH_LOGIN_LOCKDURATION=15m

# --- Bootstrap ---
# Accounts registering with these emails are created as ADMIN. Comma-separated.
AUTH_REGISTRATION_BOOTSTRAPADMINEMAILS=

# --- Browser clients ---
# Empty means no cross-origin access. Comma-separated.
AUTH_CORS_ALLOWEDORIGINS=
